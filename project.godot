; Engine configuration file.
; BlockLoot: Face-Off -- generated for Godot 4.4+ (opens cleanly in 4.5 / 4.6 / 4.7).

config_version=5

[application]

config/name="BlockLoot: Face-Off"
config/description="Arcade puzzle-battler with face-wrapped cartoon fighters and 150 procedural gear items."
run/main_scene="res://scenes/MainMenu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.14, 0.09, 0.26, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

AppInfo="*res://scripts/AppInfo.gd"
SaveManager="*res://scripts/SaveManager.gd"
InputHub="*res://scripts/InputHub.gd"
UIKit="*res://scripts/UIKit.gd"
FaceManager="*res://scripts/FaceManager.gd"
GearDatabase="*res://scripts/GearDatabase.gd"
AudioSynth="*res://scripts/AudioSynth.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

